[Unit]
Description=Labgrid %i Exporter
After=labgrid-coordinator.service
Requires=labgrid-coordinator.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Environment="PYTHONUNBUFFERED=1"
Environment="BOARDGARDEN_ROOT=/home/labgrid/boardgarden"
EnvironmentFile=-/etc/labgrid/boardgarden.env
# udev may still be finishing device setup (attribute groups, USB re-enumeration
# after a transient disconnect) right as this unit starts; without settling
# first, labgrid's udev matching can read a gpiochip's sysfs attrs mid-populate
# and crash the whole exporter instead of retrying.
ExecStartPre=/usr/bin/udevadm settle --timeout=10
ExecStart=/bin/sh -c 'exec "${BOARDGARDEN_ROOT}/boards/.venv/bin/labgrid-exporter" -n "%i-exporter" "${BOARDGARDEN_ROOT}/boards/%i/exporter.yaml"'
Restart=always
RestartSec=30
User=labgrid
Group=labgrid
# Adjust to your distribution (most often "dialout" or "tty")
SupplementaryGroups=dialout plugdev

[Install]
WantedBy=multi-user.target
