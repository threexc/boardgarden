[Unit]
Description=Labgrid Coordinator Service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment="PYTHONUNBUFFERED=1"
Environment="BOARDGARDEN_ROOT=/home/labgrid/boardgarden"
EnvironmentFile=-/etc/labgrid/boardgarden.env
ExecStart=/bin/sh -c 'exec "${BOARDGARDEN_ROOT}/boards/.venv/bin/labgrid-coordinator"'
Restart=always
RestartSec=30
User=labgrid
Group=labgrid
# labgrid-coordinator reads/writes places.yaml relative to its cwd. Without
# this, cwd defaults to / and it fights over /places.yaml with whatever else
# runs it as a different user.
StateDirectory=labgrid-coordinator
WorkingDirectory=/var/lib/labgrid-coordinator

[Install]
WantedBy=multi-user.target
