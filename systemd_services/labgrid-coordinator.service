[Unit]
Description=Labgrid Coordinator Service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment="PYTHONUNBUFFERED=1"
Environment="BOARDGARDEN_ROOT=/home/labgrid/boardgarden"
EnvironmentFile=-/etc/labgrid/boardgarden.env
ExecStart=${BOARDGARDEN_ROOT}/boards/.venv/bin/labgrid-coordinator
Restart=always
RestartSec=30
User=labgrid
Group=labgrid

[Install]
WantedBy=multi-user.target
