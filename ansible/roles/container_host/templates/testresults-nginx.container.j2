[Unit]
Description=Testresults file server (nginx)
After=network-online.target
Wants=network-online.target

[Container]
Image={{ container_host_testresults_nginx_image }}
ContainerName=testresults-nginx
User={{ container_host_testresults_reporter_uid.stdout }}:{{ container_host_testresults_reporter_gid.stdout }}
PublishPort={{ container_host_testresults_nginx_port }}:8080
Volume={{ container_host_testresults_path }}:/usr/share/nginx/html:ro,Z
Volume={{ container_host_testresults_nginx_conf_dir }}/testresults-nginx.conf:/etc/nginx/conf.d/default.conf:ro,Z

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
