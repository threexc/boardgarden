#!/bin/sh
# Usage: machine-info <column>[,<column>...] [<yocto MACHINE>]
#
# Print the given columns (tab-separated) of each boards/machines.tsv row for
# a Yocto MACHINE, in board order, or of every row if no MACHINE is given.
# Several rows can share a MACHINE (RAM variants of one board, etc.).
# The index is generated by boardfarm-render from boards/*/board.yaml; see
# INDEX_COLUMNS in common/src/boardfarm_common/render.py for the columns.
exec awk -F'\t' -v OFS='\t' -v cols="$1" -v m="${2-}" '
  NR == 1 {
    for (i = 1; i <= NF; i++) idx[$i] = i
    n = split(cols, want, ",")
    for (i = 1; i <= n; i++)
      if (!(want[i] in idx)) { print "machine-info: unknown column " want[i] > "/dev/stderr"; exit 1 }
    next
  }
  m == "" || $idx["machine"] == m {
    line = $idx[want[1]]
    for (i = 2; i <= n; i++) line = line OFS $idx[want[i]]
    print line
  }
' "$(dirname "$0")/../../boards/machines.tsv"
